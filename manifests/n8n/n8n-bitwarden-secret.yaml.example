# BitwardenSecret for n8n
# This file is a template. Copy to n8n-bitwarden-secret.yaml and fill in actual values.
#
# Steps:
# 1. Create secret in Bitwarden Secrets Manager:
#    - n8n-encryption-key (value: generate with: openssl rand -hex 32)
#
# 2. Get secret ID from Bitwarden (click on the secret in web UI)
#
# 3. Copy this file:
#    cp n8n-bitwarden-secret.yaml.example n8n-bitwarden-secret.yaml
#
# 4. Replace REPLACE_WITH_* values with actual IDs
#
# 5. Apply:
#    kubectl apply -f n8n-bitwarden-secret.yaml

apiVersion: k8s.bitwarden.com/v1
kind: BitwardenSecret
metadata:
  name: n8n-secret
  namespace: n8n
  labels:
    app: n8n
spec:
  # Organization ID from Bitwarden
  # Get from: Bitwarden Web Vault → Settings → Organization ID
  organizationId: "REPLACE_WITH_YOUR_ORG_ID"

  # Reference to the operator's access token secret
  authToken:
    secretName: bw-auth-token
    secretNamespace: sm-operator-system

  # Name of the Kubernetes secret to create/update
  secretName: n8n-secret

  # Map Bitwarden secret to Kubernetes secret key
  # Get secret ID from Bitwarden Web UI
  map:
    - bwSecretId: "REPLACE_WITH_N8N_ENCRYPTION_KEY_SECRET_ID"
      secretKeyName: N8N_ENCRYPTION_KEY
