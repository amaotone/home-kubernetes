# BitwardenSecret for PostgreSQL
# This file is a template. Copy to postgres-bitwarden-secret.yaml and fill in actual values.
#
# Steps:
# 1. Create secrets in Bitwarden Secrets Manager:
#    - postgres-user (value: postgres)
#    - postgres-password (value: your-secure-password)
#    - postgres-db (value: n8n)
#    - postgres-non-root-user (value: n8n)
#    - postgres-non-root-password (value: your-secure-password)
#
# 2. Get secret IDs from Bitwarden (click on each secret in web UI)
#
# 3. Copy this file:
#    cp postgres-bitwarden-secret.yaml.example postgres-bitwarden-secret.yaml
#
# 4. Replace REPLACE_WITH_* values with actual IDs
#
# 5. Apply:
#    kubectl apply -f postgres-bitwarden-secret.yaml

apiVersion: k8s.bitwarden.com/v1
kind: BitwardenSecret
metadata:
  name: postgres-secret
  namespace: n8n
  labels:
    app: postgres
spec:
  # Organization ID from Bitwarden
  # Get from: Bitwarden Web Vault → Settings → Organization ID
  organizationId: "REPLACE_WITH_YOUR_ORG_ID"

  # Reference to the operator's access token secret
  authToken:
    secretName: bw-auth-token
    secretNamespace: sm-operator-system

  # Name of the Kubernetes secret to create/update
  secretName: postgres-secret

  # Map Bitwarden secrets to Kubernetes secret keys
  # Get secret IDs from Bitwarden Web UI
  map:
    - bwSecretId: "REPLACE_WITH_POSTGRES_USER_SECRET_ID"
      secretKeyName: POSTGRES_USER

    - bwSecretId: "REPLACE_WITH_POSTGRES_PASSWORD_SECRET_ID"
      secretKeyName: POSTGRES_PASSWORD

    - bwSecretId: "REPLACE_WITH_POSTGRES_DB_SECRET_ID"
      secretKeyName: POSTGRES_DB

    - bwSecretId: "REPLACE_WITH_POSTGRES_NON_ROOT_USER_SECRET_ID"
      secretKeyName: POSTGRES_NON_ROOT_USER

    - bwSecretId: "REPLACE_WITH_POSTGRES_NON_ROOT_PASSWORD_SECRET_ID"
      secretKeyName: POSTGRES_NON_ROOT_PASSWORD
